function reiniciarValores() {
  pagos = [];
  dineroTotal = 0;
}


listaTarjetas.forEach(function(tarjeta) {
  tarjeta.addEventListener("click", function() {
    let idSeleccionado = tarjeta.getAttribute("data-id");
    registrarPago(idSeleccionado);
  });
});


